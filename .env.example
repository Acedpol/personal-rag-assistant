UPLOAD_DIR=./data/documents
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4

# Optional: without this, /ask uses an honest mock generator that shows the
# retrieved chunks instead of a synthesized answer. Set it to get real
# answers from Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
